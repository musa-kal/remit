<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON logs on stdout (NFR-01). Every line carries "service" (a logback context property, which
  LogstashEncoder writes on each event) plus the MDC keys correlationId (batch id),
  idempotencyKey and fileName when they are set. Account numbers are masked in the code that
  logs them (MaskingUtil); never log a raw row or account.
  The test profile logs plain text so test reports stay readable.
-->
<configuration>
  <springProperty scope="context" name="service" source="spring.application.name" defaultValue="intake-service"/>

  <springProfile name="!test">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>correlationId</includeMdcKeyName>
        <includeMdcKeyName>idempotencyKey</includeMdcKeyName>
        <includeMdcKeyName>fileName</includeMdcKeyName>
        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
          <maxDepthPerThrowable>30</maxDepthPerThrowable>
          <rootCauseFirst>true</rootCauseFirst>
        </throwableConverter>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>

  <springProfile name="test">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="CONSOLE_LOG_PATTERN" value="%d{HH:mm:ss.SSS} %-5level [%X{correlationId:-}] %logger{36} - %msg%n"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
