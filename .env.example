# Remit local environment. Copy to .env and replace every value marked change-me.
# .env is gitignored; never commit real secrets. Avoid quotes and $ in values.

# Docker Compose project name (prefixes container, network and volume names).
COMPOSE_PROJECT_NAME=remit

# ---------------------------------------------------------------------------
# MySQL 8 (one schema and one least-privilege user per service)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-mysql-root
# Host port published by compose and used by services running outside compose (local profile).
# 3307 avoids clashing with a natively installed MySQL on 3306.
REMIT_MYSQL_HOST=localhost
REMIT_MYSQL_PORT=3307
# Users remit_intake, remit_routing and remit_api are created by docker/mysql.
REMIT_INTAKE_DB_PASSWORD=change-me-intake-db
REMIT_ROUTING_DB_PASSWORD=change-me-routing-db
REMIT_API_DB_PASSWORD=change-me-api-db

# ---------------------------------------------------------------------------
# MongoDB 7 (audit trail)
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
# Host port published by compose; 27018 avoids clashing with a native MongoDB on 27017.
REMIT_MONGO_HOST=localhost
REMIT_MONGO_PORT=27018
# Application user for the remit_audit database (insert and read only).
REMIT_MONGO_USER=remit_audit
REMIT_MONGO_PASSWORD=change-me-mongo-audit

# ---------------------------------------------------------------------------
# Kafka 3 (KRaft). Inside compose the services use kafka:9092.
# ---------------------------------------------------------------------------
REMIT_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Host port for Kafka UI (only with: docker compose --profile tools up -d).
KAFKA_UI_PORT=8090

# ---------------------------------------------------------------------------
# SFTP drop zone (atmoz/sftp). Home dirs: inbound, processing, processed, error.
# ---------------------------------------------------------------------------
REMIT_SFTP_HOST=localhost
REMIT_SFTP_PORT=2222
REMIT_SFTP_USER=remit
REMIT_SFTP_PASSWORD=change-me-sftp
# How often intake-service polls /inbound (Spring duration format).
REMIT_SFTP_POLL_INTERVAL=30s

# ---------------------------------------------------------------------------
# intake-service
# ---------------------------------------------------------------------------
# HTTP port for actuator (health, info, metrics, ingestjobs) when run outside compose.
REMIT_INTAKE_PORT=8081
# Local directory for staged files while their job runs (default: <tmp>/remit-staging).
# REMIT_STAGING_DIR=/var/tmp/remit-staging
# Optional demo override that pins the business date (ISO yyyy-MM-dd). Leave empty for the
# real date. The sample files need a date between 2026-09-15 and 2026-10-15; see ADR 0005.
REMIT_CLOCK_FIXED_DATE=

# ---------------------------------------------------------------------------
# api-service security
# ---------------------------------------------------------------------------
# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
REMIT_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Passwords for the seeded local users (operator: OPERATOR, admin: OPERATOR + ADMIN).
REMIT_OPERATOR_PASSWORD=change-me-operator
REMIT_ADMIN_PASSWORD=change-me-admin
