# Remit local environment. Copy to .env and replace every value marked change-me.
# .env is gitignored; never commit real secrets. Avoid quotes and $ in values.

# Docker Compose project name (prefixes container, network and volume names).
COMPOSE_PROJECT_NAME=remit
# Tag of the remit/<service> images that compose builds and runs (scripts/build.sh also tags the
# git short SHA).
REMIT_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# MySQL 8 (one schema and one least-privilege user per service)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-mysql-root
# Host port published by compose and used by services running outside compose (local profile).
# 3307 avoids clashing with a natively installed MySQL on 3306.
REMIT_MYSQL_HOST=localhost
REMIT_MYSQL_PORT=3307
# Users remit_intake, remit_routing and remit_api are created by docker/mysql.
REMIT_INTAKE_DB_PASSWORD=change-me-intake-db
REMIT_ROUTING_DB_PASSWORD=change-me-routing-db
REMIT_API_DB_PASSWORD=change-me-api-db

# ---------------------------------------------------------------------------
# MongoDB 7 (audit trail)
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-root
# Host port published by compose; 27018 avoids clashing with a native MongoDB on 27017.
REMIT_MONGO_HOST=localhost
REMIT_MONGO_PORT=27018
# Application user for the remit_audit database (insert and read only). api-service puts the
# password in a mongodb:// URI, so use URL-safe characters only (letters, digits, - . _ ~).
REMIT_MONGO_USER=remit_audit
REMIT_MONGO_PASSWORD=change-me-mongo-audit

# ---------------------------------------------------------------------------
# Kafka 3 (KRaft). Inside compose the services use kafka:9092.
# ---------------------------------------------------------------------------
REMIT_KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Host port for Kafka UI (only with: docker compose --profile tools up -d).
KAFKA_UI_PORT=8090

# ---------------------------------------------------------------------------
# SFTP drop zone (atmoz/sftp). Home dirs: inbound, processing, processed, error.
# ---------------------------------------------------------------------------
REMIT_SFTP_HOST=localhost
REMIT_SFTP_PORT=2222
REMIT_SFTP_USER=remit
REMIT_SFTP_PASSWORD=change-me-sftp
# How often intake-service polls /inbound (Spring duration format). The service default is 30s;
# 10s keeps the local demo and the NFR-05 measurement from waiting on the poller.
REMIT_SFTP_POLL_INTERVAL=10s

# ---------------------------------------------------------------------------
# intake-service
# ---------------------------------------------------------------------------
# HTTP port for actuator (health, info, metrics, ingestjobs): the host port compose publishes, and
# the port a jar run outside compose listens on.
REMIT_INTAKE_PORT=8081
# Local directory for staged files while their job runs, outside compose (default:
# <tmp>/remit-staging). Compose uses the intake-staging volume at /app/staging.
# REMIT_STAGING_DIR=/var/tmp/remit-staging
# Demo override that pins the business date (ISO yyyy-MM-dd). The sample files need a date between
# 2026-09-15 and 2026-10-15; see ADR 0005. Compose uses 2026-10-15 when this is not set at all;
# an empty value means the real date.
REMIT_CLOCK_FIXED_DATE=2026-10-15

# ---------------------------------------------------------------------------
# routing-service
# ---------------------------------------------------------------------------
# HTTP port for actuator (health, info, metrics): the host port compose publishes, and the port a
# jar run outside compose listens on.
# The database password is REMIT_ROUTING_DB_PASSWORD above. The FORCE_FAIL chaos hook is on in
# the local and docker profiles and off in k8s; the local Kubernetes overlay turns it on with
# REMIT_ROUTING_CHAOSENABLED=true in its ConfigMap. It is not read from this file.
REMIT_ROUTING_PORT=8082

# ---------------------------------------------------------------------------
# api-service
# ---------------------------------------------------------------------------
# HTTP port of the operator API, Swagger UI (/swagger-ui.html) and actuator: the host port compose
# publishes, and the port a jar run outside compose listens on.
# The database password is REMIT_API_DB_PASSWORD above, the MongoDB user REMIT_MONGO_* above.
REMIT_API_PORT=8080
# HS256 signing key, at least 32 bytes; startup fails without it. Generate one with:
# openssl rand -base64 48   (rotating it logs every user out, see docs/runbook.md)
REMIT_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Passwords for the users seeded at startup when missing (operator: OPERATOR, admin: OPERATOR +
# ADMIN). Seeding is on in the local and docker profiles; an existing user is never changed.
REMIT_OPERATOR_PASSWORD=change-me-operator
REMIT_ADMIN_PASSWORD=change-me-admin
# Optional override of the seeding switch (true in local and docker, false in k8s and elsewhere).
# REMIT_SEED_USERS_ENABLED=true

# ---------------------------------------------------------------------------
# Kubernetes (local kind cluster, scripts/k8s-*.sh)
# ---------------------------------------------------------------------------
# scripts/k8s-secrets.sh builds the remit-secrets Secret from the values above. The scripts use
# the kubectl context kind-remit; set this to use another context (empty: the current context).
# REMIT_KUBE_CONTEXT=kind-remit

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown; leave commented unless you need them)
# ---------------------------------------------------------------------------
# Database user names of the three services (the users docker/mysql creates).
# REMIT_INTAKE_DB_USER=remit_intake
# REMIT_ROUTING_DB_USER=remit_routing
# REMIT_API_DB_USER=remit_api
# Ports the docker and k8s profiles use inside the network (the host ports are above).
# REMIT_MYSQL_INTERNAL_PORT=3306
# REMIT_MONGO_INTERNAL_PORT=27017
# REMIT_SFTP_INTERNAL_PORT=22
# API base URL for scripts/smoke-test.sh, newman.sh and perf-test.sh (default
# http://localhost:${REMIT_API_PORT}); CI uses http://dind:8080.
# REMIT_API_URL=http://localhost:8080
# Transport scripts/smoke-test.sh passes to seed-sftp.sh: compose (default), kubectl, sftp.
# REMIT_SEED_VIA=compose
# REMIT_ROOT, REMIT_APP_SERVICES, REMIT_KIND_CLUSTER and REMIT_K8S_NAMESPACE are set by
# scripts/lib.sh and are not read from this file.
