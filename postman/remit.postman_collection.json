        {
          "name": "Login with blank credentials returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('body matches the ProblemDetail schema', function () {",
                  "  pm.response.to.have.jsonSchema({",
                  "    \"type\": \"object\",",
                  "    \"required\": [",
                  "      \"type\",",
                  "      \"title\",",
                  "      \"status\",",
                  "      \"detail\",",
                  "      \"instance\"",
                  "    ],",
                  "    \"properties\": {",
                  "      \"type\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"title\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"status\": {",
                  "        \"type\": \"integer\",",
                  "        \"minimum\": 400,",
                  "        \"maximum\": 599",
                  "      },",
                  "      \"detail\": {",
                  "        \"type\": \"string\"",
                  "      },",
                  "      \"instance\": {",
                  "        \"type\": \"string\",",
                  "        \"pattern\": \"^/\"",
                  "      },",
                  "      \"errors\": {",
                  "        \"type\": \"array\",",
                  "        \"minItems\": 1,",
                  "        \"items\": {",
                  "          \"type\": \"object\",",
                  "          \"required\": [",
                  "            \"field\",",
                  "            \"message\"",
                  "          ],",
                  "          \"properties\": {",
                  "            \"field\": {",
                  "              \"type\": \"string\"",
                  "            },",
                  "            \"message\": {",
                  "              \"type\": \"string\"",
                  "            }",
                  "          }",
                  "        }",
                  "      }",
                  "    }",
                  "  });",
                  "});",
                  "const problem = pm.response.json();",
                  "pm.test('problem says 400 Bad Request', function () {",
                  "  pm.expect(problem.status).to.eql(400);",
                  "  pm.expect(problem.title).to.eql('Bad Request');",
                  "});",
                  "pm.test('problem detail explains the error', function () {",
                  "  pm.expect(problem.detail).to.eql('The request has invalid fields');",
                  "});",
                  "pm.test('problem instance is the request path', function () {",
                  "  pm.expect(problem.instance).to.eql('/api/v1/auth/login');",
                  "});",
                  "pm.test('field error on username: must not be blank', function () {",
                  "  const error = (problem.errors || []).find(function (e) {",
                  "    return e.field === 'username';",
                  "  });",
                  "  pm.expect(error, 'error for username').to.be.an('object');",
                  "  pm.expect(error.message).to.include('must not be blank');",
                  "});",
                  "pm.test('field error on password: must not be blank', function () {",
                  "  const error = (problem.errors || []).find(function (e) {",
                  "    return e.field === 'password';",
                  "  });",
                  "  pm.expect(error, 'error for password').to.be.an('object');",
                  "  pm.expect(error.message).to.include('must not be blank');",
                  "});"
                ]
              }
            }
          ],
          "request": {
