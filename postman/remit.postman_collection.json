  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{operatorToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Logs in as operator and admin when a token is missing or older than 10 minutes (tokens live",
          "// 15 minutes) and stores both tokens in collection variables. Requests send {{operatorToken}}",
          "// through the collection auth; ADMIN-only requests override it with {{adminToken}}.",
          "const maxAgeMs = 10 * 60 * 1000;",
          "const now = Date.now();",
          "const issuedAt = Number(pm.collectionVariables.get('tokenIssuedAt')) || 0;",
          "const blockedUntil = Number(pm.collectionVariables.get('loginBlockedUntil')) || 0;",
          "const haveTokens = Boolean(pm.collectionVariables.get('operatorToken') && pm.collectionVariables.get('adminToken'));",
          "",
          "if ((!haveTokens || now - issuedAt >= maxAgeMs) && now >= blockedUntil) {",
          "  const users = [",
          "    {",
          "      tokenVariable: 'operatorToken',",
          "      username: pm.variables.get('operatorUsername'),",
          "      password: pm.variables.get('operatorPassword')",
          "    },",
          "    {",
          "      tokenVariable: 'adminToken',",
          "      username: pm.variables.get('adminUsername'),",
          "      password: pm.variables.get('adminPassword')",
          "    }",
          "  ];",
          "  const incomplete = users.filter(function (user) {",
          "    return !user.username || !user.password;",
          "  });",
          "",
          "  if (incomplete.length > 0) {",
          "    console.error('Set operatorUsername, operatorPassword, adminUsername and adminPassword in the environment ' +",
          "      '(newman: --env-var operatorPassword=... --env-var adminPassword=...). Not logging in.');",
          "  } else {",
          "    const login = function (index) {",
          "      if (index === users.length) {",
          "        pm.collectionVariables.set('tokenIssuedAt', String(now));",
          "        return;",
          "      }",
          "      const user = users[index];",
          "      pm.sendRequest({",
          "        url: pm.variables.get('baseUrl') + '/auth/login',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ username: user.username, password: user.password }) }",
          "      }, function (error, response) {",
          "        if (error) {",
          "          console.error('Login as ' + user.username + ' failed: ' + error);",
          "          return;",
          "        }",
          "        if (response.code !== 200) {",
          "          if (response.code === 401 || response.code === 429) {",
          "            // Five failures lock the username for 10 minutes; do not add more.",
          "            pm.collectionVariables.set('loginBlockedUntil', String(Date.now() + maxAgeMs));",
          "          }",
          "          console.error('Login as ' + user.username + ' answered ' + response.code + ': ' + response.text());",
          "          return;",
          "        }",
          "        pm.collectionVariables.set(user.tokenVariable, response.json().accessToken);",
          "        login(index + 1);",
          "      });",
          "    };",
          "    login(0);",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Checks that hold for every response of the API.",
          "pm.test('[common] response carries an X-Correlation-Id header', function () {",
          "  pm.response.to.have.header('X-Correlation-Id');",
          "});",
          "pm.test('[common] response time is below 5 s', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "if (pm.response.code >= 400) {",
          "  pm.test('[common] error is application/problem+json without internals', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
          "    pm.expect(pm.response.text()).to.not.match(/Exception|\\tat [a-z]/);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "operatorToken",
      "value": "",
      "type": "string",
      "description": "Access token of the operator user (set by the collection pre-request script)"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Access token of the admin user (set by the collection pre-request script)"
    },
    {
      "key": "tokenIssuedAt",
      "value": "",
      "type": "string",
      "description": "Epoch milliseconds of the last login by the collection pre-request script"
    },
    {
      "key": "loginBlockedUntil",
      "value": "",
      "type": "string",
      "description": "Epoch milliseconds until which the pre-request script will not log in after a refused login"
    }
  ]
}
