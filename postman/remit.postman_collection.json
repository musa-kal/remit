                  "});",
                  "pm.test('claims carry iat, exp 15 minutes later and a jti', function () {",
                  "  pm.expect(claims.exp - claims.iat).to.eql(900);",
                  "  pm.expect(claims.jti).to.be.a('string').and.not.be.empty;",
                  "});",
                  "pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
