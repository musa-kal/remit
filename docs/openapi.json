{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Monitor payment batches, inspect rejected rows and dead letters, replay dead letters and read the audit trail. Log in with POST /api/v1/auth/login and send the token as Authorization: Bearer.",
    "title" : "Remit operator API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Local"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Counts by status",
    "name" : "Stats"
  }, {
    "description" : "Dead-lettered instructions and their replay",
    "name" : "Dead Letters"
  }, {
    "description" : "Instruction detail and status history",
    "name" : "Instructions"
  }, {
    "description" : "The append-only audit trail",
    "name" : "Audit"
  }, {
    "description" : "Batch files, their instructions and rejected rows",
    "name" : "Batches"
  }, {
    "description" : "Obtain an access token",
    "name" : "Auth"
  } ],
  "paths" : {
    "/api/v1/audit-events" : {
      "get" : {
        "operationId" : "list_2",
        "parameters" : [ {
          "in" : "query",
          "name" : "entityId",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "in" : "query",
          "name" : "eventType",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "BATCH_RECEIVED", "BATCH_COMPLETED", "INSTRUCTION_ROUTED", "INSTRUCTION_STATUS_CHANGED", "INSTRUCTION_REJECTED", "INSTRUCTION_DEAD_LETTERED", "DEAD_LETTER_RECORDED", "DLT_REPLAY_REQUESTED", "LOGIN_SUCCESS", "LOGIN_FAILURE" ]
          }
        }, {
          "example" : "2026-10-15T00:00:00Z",
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "example" : "2026-10-16T00:00:00Z",
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "description" : "Zero-based page index (0..N)",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "The size of the page to be returned",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 20,
            "minimum" : 1
          }
        }, {
          "description" : "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "type" : "array",
            "default" : [ "occurredAt,DESC" ],
            "items" : {
              "type" : "string"
            }
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAuditEventView"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List audit events, newest first",
        "tags" : [ "Audit" ]
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Logged in"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Missing username or password"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Invalid username or password"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            },
            "description" : "Username locked after 5 failed logins"
          }
        },
        "security" : [ ],
        "summary" : "Log in and receive a bearer token valid for 15 minutes",
        "tags" : [ "Auth" ]
      }
    },
