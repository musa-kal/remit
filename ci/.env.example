# Local CI stack (ci/docker-compose.jenkins.yml). ci/setup.sh copies this file to ci/.env on its
# first run and replaces every change-me value with a random one, so usually nothing has to be
# edited by hand. ci/.env is gitignored; never commit it. Avoid quotes and $ in values.

# Host ports.
JENKINS_PORT=8090
SONARQUBE_PORT=9000

# Jenkins login: user admin, this password.
JENKINS_ADMIN_PASSWORD=change-me-jenkins-admin

# SonarQube login: user admin. ci/setup.sh changes the default admin/admin password to this one.
# SonarQube requires 12+ characters with upper and lower case letters, a digit and a special
# character.
SONAR_ADMIN_PASSWORD=change-me-Sonar-Admin-1
# PostgreSQL password of the SonarQube database.
SONAR_DB_PASSWORD=change-me-sonar-db
# User token Jenkins analyses with (credential sonar-token). Written by ci/setup.sh; leave empty.
SONAR_TOKEN=

# Secrets of the Remit compose stack the pipeline deploys. Jenkins holds them as credentials
# (remit-*) and the Jenkinsfile writes them into the workspace .env; they are independent of the
# repository's own .env. REMIT_MONGO_PASSWORD goes into a mongodb:// URI (URL-safe characters
# only) and REMIT_JWT_SECRET needs at least 32 bytes.
MYSQL_ROOT_PASSWORD=change-me-mysql-root
REMIT_INTAKE_DB_PASSWORD=change-me-intake-db
REMIT_ROUTING_DB_PASSWORD=change-me-routing-db
REMIT_API_DB_PASSWORD=change-me-api-db
MONGO_ROOT_PASSWORD=change-me-mongo-root
REMIT_MONGO_PASSWORD=change-me-mongo-audit
REMIT_SFTP_PASSWORD=change-me-sftp
REMIT_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
REMIT_OPERATOR_PASSWORD=change-me-operator
REMIT_ADMIN_PASSWORD=change-me-admin
